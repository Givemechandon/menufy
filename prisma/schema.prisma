generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum MenuTheme {
  LIGHT
  DARK
}

enum MenuStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum UserRole {
  SUPER_ADMIN
  CLIENT_ADMIN
}

enum AuditStatus {
  SUCCESS
  FAILURE
}

enum AuditSeverity {
  INFO
  WARNING
  ERROR
  CRITICAL
}

model Plan {
  id         String   @id @default(cuid())
  name       String
  slug       String   @unique
  maxMenus   Int      @default(2)
  priceCents Int      @default(0)
  isActive   Boolean  @default(true)
  clients    Client[]
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("plans")
}

model Client {
  id         String     @id @default(cuid())
  name       String
  slug       String     @unique
  isActive   Boolean    @default(true)
  planId     String
  plan       Plan       @relation(fields: [planId], references: [id])
  menus      Menu[]
  categories Category[]
  products   Product[]
  users      User[]
  auditLogs Auditlog[]
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  @@index([planId])
  @@map("clients")
}

model User {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  passwordHash String
  role         UserRole  @default(CLIENT_ADMIN)
  isActive     Boolean   @default(true)
  clientId     String?
  client       Client?   @relation(fields: [clientId], references: [id], onDelete: SetNull)
  auditLogs    Auditlog[]
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([clientId])
  @@index([role])
  @@map("users")
}

model Menu {
  id             String         @id @default(cuid())
  name           String
  slug           String         @unique
  description    String?
  bannerUrl      String?
  theme          MenuTheme      @default(LIGHT)
  primaryColor   String?
  status         MenuStatus     @default(DRAFT)
  publishedAt    DateTime?
  clientId       String
  client         Client         @relation(fields: [clientId], references: [id])
  menuCategories MenuCategory[]
  menuProducts   MenuProduct[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([clientId])
  @@map("menus")
}

model Category {
  id             String         @id @default(cuid())
  name           String
  slug           String
  description    String?
  sortOrder      Int            @default(0)
  isActive       Boolean        @default(true)
  clientId       String
  client         Client         @relation(fields: [clientId], references: [id])
  products       Product[]
  menuCategories MenuCategory[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@unique([clientId, slug])
  @@index([clientId])
  @@map("categories")
}

model Product {
  id           String        @id @default(cuid())
  name         String
  description  String?
  priceCents   Int
  imageUrl     String?
  isActive     Boolean       @default(true)
  isAvailable  Boolean       @default(true)
  clientId     String
  client       Client        @relation(fields: [clientId], references: [id])
  categoryId   String
  category     Category      @relation(fields: [categoryId], references: [id])
  menuProducts MenuProduct[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([clientId])
  @@index([categoryId])
  @@map("products")
}

model MenuCategory {
  menuId     String
  categoryId String
  sortOrder  Int      @default(0)
  isVisible  Boolean  @default(true)
  menu       Menu     @relation(fields: [menuId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([menuId, categoryId])
  @@index([categoryId])
  @@map("menu_categories")
}

model MenuProduct {
  menuId           String
  productId        String
  sortOrder        Int     @default(0)
  isVisible        Boolean @default(true)
  customPriceCents Int?
  menu             Menu    @relation(fields: [menuId], references: [id], onDelete: Cascade)
  product          Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([menuId, productId])
  @@index([productId])
  @@map("menu_products")
}

model AuditLog {
  id          String        @id @default(cuid())
  action      String
  status      AuditStatus   @default(SUCCESS)
  severity    AuditSeverity @default(INFO)
  entityType  String?
  entityId    String?
  description String?
  metadata    Json?
  ipAddress   String?
  userAgent   String?
  requestId   String?
  clientId    String?
  client      Client?       @relation(fields: [clientId], references: [id], onDelete: SetNull)
  actorId     String?
  actor       User?         @relation(fields: [actorId], references: [id], onDelete: SetNull)
  createdAt   DateTime      @default(now())

  @@index([clientId, createdAt])
  @@index([actorId, createdAt])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}